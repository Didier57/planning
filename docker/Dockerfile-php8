# Use the official PHP image with Apache
FROM php:8-apache
LABEL maintainer="craig@k5n.us"
LABEL vendor="k5n.us"

# Install mysqli extension
RUN docker-php-ext-install mysqli

# Raise PHP upload limits for the admin SQL import page
# (default upload_max_filesize is 2M, too small for a DB dump).
RUN printf 'upload_max_filesize = 32M\npost_max_size = 32M\nmemory_limit = 256M\n' > $PHP_INI_DIR/conf.d/zz-uploads.ini

# Copy all files except those in .dockerignore
COPY . /var/www/html/

# Create an empty settings.php file with write permissions for anyone
# to allow the web-based installer to update it.
RUN touch /var/www/html/includes/settings.php
RUN chmod 777 /var/www/html/includes/settings.php

# Set working directory
WORKDIR /var/www/html

# Start Apache server in the foreground
CMD ["apache2-foreground"]
